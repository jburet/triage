# Local development defaults. Copy to .env and adjust.

# LiteLLM proxy. Graph code only ever asks for the aliases triage / analysis / diagnosis.
TRIAGE_LITELLM_URL=http://localhost:4000/v1
TRIAGE_LITELLM_API_KEY=sk-local-dev

# Postgres (docker-compose service). Triage tables live in the `triage` schema.
TRIAGE_DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage

# When 1, every write-capable integration is replaced by a recording fake that
# prints the payload instead of calling Jira or Slack. Default for local dev.
TRIAGE_DRY_RUN=1

# Real credentials, only needed when TRIAGE_DRY_RUN=0.
TRIAGE_SLACK_BOT_TOKEN=

# Jira Cloud. The token is an Atlassian API token for the account named by
# TRIAGE_JIRA_USER_EMAIL; the pair is sent as HTTP basic auth.
TRIAGE_JIRA_BASE_URL=https://your-org.atlassian.net
TRIAGE_JIRA_USER_EMAIL=
TRIAGE_JIRA_API_TOKEN=
