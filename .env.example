# Local development defaults. Copy to .env and adjust.

# How model calls are made: auto | litellm | anthropic.
#   auto      the proxy, unless an Anthropic key is set and the proxy URL is still
#             the default below — which is the local-development case.
#   litellm   always the proxy. This is production: it resolves the tier aliases
#             and enforces the 500k-per-run and $50-per-day caps (ADR-0007).
#   anthropic always the API directly. No spend caps. Local runs and one-shots.
TRIAGE_LLM_PROVIDER=auto

# LiteLLM proxy — the two keys to fill for an external one. The URL must end in
# /v1. `make proxy` starts a local one here instead. Note that `auto` above
# prefers the direct client as soon as an Anthropic key is set, so to go through
# a proxy you configured, say so: TRIAGE_LLM_PROVIDER=litellm.
TRIAGE_LITELLM_URL=http://localhost:4000/v1
TRIAGE_LITELLM_API_KEY=sk-local-dev

# Which model serves each tier. Configuration, never code: no model name appears
# under src/, and graph code only ever asks for a tier (ADR-0007).
#
# These serve both paths, and mean slightly different things on each:
#   - calling Anthropic directly, they are the model ids, and all three are required
#   - through a proxy, they are what *that proxy* calls those models. Clear all
#     three if it publishes the aliases triage / analysis / diagnosis, which is
#     what a proxy configured for Triage does; fill all three if it is a shared
#     proxy nobody will re-configure. Filling some is refused.
TRIAGE_ANTHROPIC_API_KEY=
TRIAGE_MODEL_TRIAGE=claude-haiku-4-5
TRIAGE_MODEL_ANALYSIS=claude-sonnet-5
TRIAGE_MODEL_DIAGNOSIS=claude-opus-5

# Postgres (docker-compose service). Triage tables live in the `triage` schema.
TRIAGE_DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage

# When 1, every write-capable integration is replaced by a recording fake that
# prints the payload instead of calling Jira or Slack. Default for local dev.
TRIAGE_DRY_RUN=1

# Real credentials, only needed when TRIAGE_DRY_RUN=0.
TRIAGE_SLACK_BOT_TOKEN=

# Jira Cloud. The token is an Atlassian API token for the account named by
# TRIAGE_JIRA_USER_EMAIL; the pair is sent as HTTP basic auth.
TRIAGE_JIRA_BASE_URL=https://your-org.atlassian.net
TRIAGE_JIRA_USER_EMAIL=
TRIAGE_JIRA_API_TOKEN=

# LangGraph Platform. Left empty, the poller invokes the incident graph in this
# process instead of creating a run — same graph, same thread id, no queue
# (ADR-0011). Set it once the Platform is deployed.
TRIAGE_PLATFORM_URL=
TRIAGE_PLATFORM_API_KEY=
