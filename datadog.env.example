# Datadog — read-only credentials for the F1 collector.
#
# Append to your .env and fill in the two blanks:
#
#     cat datadog.env.example >> .env
#
# The application key must be created on a SERVICE ACCOUNT, not on a person's
# account: Datadog application keys are user-scoped and are revoked when that
# user is deprovisioned. Grant it exactly these scopes, all read-only:
#
#     monitors_read     monitor definition, thresholds and group states
#     timeseries_query  re-running the monitor's own query over a wider window
#     logs_read_data    log search and aggregation
#     apm_read          span search and aggregation
#     events_read       the monitor-alert event stream Triage polls, plus the
#                       deployment and Kubernetes events in the alert window
#
# Nothing here grants a write: Triage is read-only on Datadog by design.

# API host for your Datadog site. EU: api.datadoghq.eu — US1: api.datadoghq.com
TRIAGE_DATADOG_SITE=api.datadoghq.eu

# Org API key, sent as DD-API-KEY.
TRIAGE_DATADOG_API_KEY=

# Scoped application key, sent as DD-APPLICATION-KEY.
TRIAGE_DATADOG_APP_KEY=
